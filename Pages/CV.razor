@page "/Contact"
@inject IJSRuntime JSRuntime

<PageTitle>Contact</PageTitle>

<div class="flex">
    <input type="text" id="name" placeholder="Full Name" @bind="_name">
    <input type="email" id="email" placeholder="Email" @bind="_email">
    <textarea placeholder="Description" @bind="_description"></textarea>
    
    <div class="action-row">
        
        <button class="submit-btn" @onclick="SubmitFormAsync" disabled="@_isSubmitting">
            @(_isSubmitting ? "SENDING..." : "SUBMIT")
        </button>

        <div class="controls-container">
            <span class="help-tooltip-trigger">?
                <span class="tooltip-box">This form securely sends your message directly to my inbox using EmailJS!</span>
            </span>
        </div>
        
    </div>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="status-message" style="margin-top: 20px; font-family: monospace; color: var(--text-primary);">
            @_statusMessage
        </div>
    }
</div>

@code {
    // Stores what the user types into the form
    private string _name = "";
    private string _email = "";
    private string _description = "";
    
    // UI state
    private bool _isSubmitting = false;
    private string _statusMessage = "";

    private async Task SubmitFormAsync()
    {
        // 1. Basic validation - don't send if they left something blank
        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_description))
        {
            _statusMessage = "Please fill out all fields.";
            return;
        }

        // 2. Lock the UI and prepare to send
        _isSubmitting = true;
        _statusMessage = "";
        
        try
        {
            // 3. Call out to JavaScript to handle the actual EmailJS logic
            await JSRuntime.InvokeVoidAsync("sendEmailJS", _name, _email, _description);
            
            // 4. If it worked, tell the user and wipe the form clean
            _statusMessage = "Message sent successfully!";
            _name = "";
            _email = "";
            _description = "";
        }
        catch (Exception ex)
        {
            // If the internet is down or EmailJS fails, catch it so the app doesn't crash
            _statusMessage = "Failed to send message. Please try again later.";
            Console.WriteLine($"EmailJS Error: {ex.Message}");
        }
        finally
        {
            // Always unlock the submit button at the very end, even on failure
            _isSubmitting = false;
        }
    }
}